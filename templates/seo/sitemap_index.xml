{% load static %}<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/css" href="{% static 'seo/sitemap.css' %}"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for site in sitemaps %}  <sitemap>
    <loc>{{ site.loc }}</loc>{% if site.lastmod %}
    <lastmod>{{ site.lastmod }}</lastmod>{% endif %}
  </sitemap>
{% endfor %}</sitemapindex>
