{% load static %}<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/css" href="{% static 'build/seo-sitemap.css' %}"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for site in sitemaps %}  <sitemap>
    <loc>{{ site.location }}</loc>{% if site.last_mod %}
    <lastmod>{{ site.last_mod|date:"c" }}</lastmod>{% endif %}
  </sitemap>
{% endfor %}</sitemapindex>
