{% load static %}<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/css" href="{% static 'build/seo-sitemap.css' %}"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for url in urlset %}  <url>
    <loc>{{ url.location }}</loc>{% if url.lastmod %}
    <lastmod>{{ url.lastmod|date:"c" }}</lastmod>{% endif %}{% for alternate in url.alternates %}
    <xhtml:link rel="alternate" hreflang="{{ alternate.lang_code }}" href="{{ alternate.location }}"/>{% endfor %}
  </url>
{% endfor %}</urlset>
