# Copy to .env and replace every placeholder. Never commit .env.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Core ------------------------------------------------------------------
# app.settings.local (development), app.settings.production (deployment).
DJANGO_SETTINGS_MODULE=app.settings.local
# Production requires >= 50 random characters.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME=Mobofirm
# Public origin, e.g. https://mobofirm.example (https:// is required in production).
SITE_URL=

# --- Database --------------------------------------------------------------
DB_NAME=mobofirm
DB_USER=mobofirm_app
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis: shared cache (rate limits, MFA throttles) and Celery broker -----
# Production requires CACHE_URL; without it a per-process cache is used (dev only).
CACHE_URL=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# celery (production default) or sync (runs tasks inline; development only).
QUEUE_BACKEND=sync

# --- Secrets at rest (required in production; keep separate from SECRET_KEY) --
# Any random string, >= 32 characters.
MFA_ENCRYPTION_KEY=
# Must be a Fernet key (see the command above).
SOCIAL_CREDENTIAL_ENCRYPTION_KEY=

# --- Reverse proxy -----------------------------------------------------------
# Number of trusted proxies in front of the app (nginx = 1; production default 1).
# Forwarded headers are ignored when this is 0.
TRUSTED_PROXY_COUNT=0
# Optional allow-list of proxy peer IPs (comma separated).
TRUSTED_PROXIES=
# Optional edge header carrying the visitor country, e.g. CF-IPCountry.
COUNTRY_HEADER=
# Extra https:// origins for CSRF (defaults to SITE_URL).
DJANGO_CSRF_TRUSTED_ORIGINS=
USE_X_FORWARDED_HOST=false

# --- Email (production needs SMTP or Gmail; development uses the console) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
GMAIL_ENABLED=false
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=

# --- Authentication and abuse controls ---------------------------------------
ENABLE_SIGNUP=true
REQUIRE_MFA=false
SIGNUP_ATTEMPTS_PER_HOUR=10
# Seconds an API token stays valid (default 7 days).
API_TOKEN_TTL_SECONDS=604800
# Google sign-in: set both or neither.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
RECAPTCHA_ENABLED=false
RECAPTCHA_MODE=off
RECAPTCHA_SITE_KEY=
RECAPTCHA_PRIVATE_KEY=

# --- Devices -----------------------------------------------------------------
DEVICE_MAX_PENDING_PER_USER=10
# Days to keep device events (raw IP and user agent); 0 disables the purge task.
DEVICE_EVENT_RETENTION_DAYS=90

# --- Content security --------------------------------------------------------
# Ad-network hostnames allowed to serve scripts/frames/images (empty = none).
CSP_AD_HOSTS=

# --- Logging -----------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
# When set, also write a daily-rotated file here, keeping LOG_RETENTION_DAYS files.
LOG_DIR=
LOG_RETENTION_DAYS=14

# --- Docker Compose (production topology) ------------------------------------
# DB_HOST/CACHE_URL/CELERY_BROKER_URL are overridden by docker-compose.yml.
CELERY_CONCURRENCY=2
GUNICORN_WORKERS=
GUNICORN_THREADS=2
