DJANGO_SETTINGS_MODULE=app.settings.local
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=mobofirm
DB_USER=mobofirm_app
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Configure Redis separately before enabling asynchronous task workers.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
