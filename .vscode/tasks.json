{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Pylint: strict workspace",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "pylint",
                "--enable=all",
                "--fail-on=E,F,W,R,C,I",
                "app",
                "apps",
                "tests",
                "scripts",
                "manage.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                {
                    "owner": "pylint",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^(.+?):(\\d+):(\\d+): ([EF]\\d{4}): (.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "code": 4,
                        "message": 5,
                        "severity": "error"
                    }
                },
                {
                    "owner": "pylint",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^(.+?):(\\d+):(\\d+): ([WRCI]\\d{4}): (.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "code": 4,
                        "message": 5,
                        "severity": "warning"
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
